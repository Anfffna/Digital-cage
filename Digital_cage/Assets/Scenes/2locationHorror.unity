--- !u!114 &1859292656
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1859292654}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 188bbfa3bb3909e4bbeba48bd6f891b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  triggerEnabled: 0
  dialogueManager: {fileID: 583009123}
  dialogueLines:
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0421\u0432\u044F\u0437\u044C...\u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430.
    \u0412\u0438\u043A\u0442\u043E\u0440, \u0443 \u0432\u0430\u0441 \u0432\u0441\u0451
    \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435?"
  - "<color=#00FFFF>\u041D\u0438 \u0447\u0435\u0440\u0442\u0430 \u043D\u0435 \u0432
    \u043F\u043E\u0440\u044F\u0434\u043A\u0435.. \u0427\u0422\u041E \u0432\u044B\u0448\u043B\u043E
    \u0438\u0437 \u044D\u0442\u043E\u0439 \u0434\u0432\u0435\u0440\u0438? \u041F\u043E\u0447\u0435\u043C\u0443
    \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u043D\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430?!</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0442\u0435\u0441\u044C,
    \u043F\u0440\u043E\u0441\u0442\u043E \u0432 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437
    \u0441 \u0432\u0430\u043C\u0438 \u0432\u0441\u0451 \u043F\u043E\u0448\u043B\u043E
    \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043D\u0435 \u043F\u043E \u043F\u043B\u0430\u043D\u0443.
    \u041E\u0439.."
  - "<color=#00FFFF>\u042D\u0442\u043E \u043C\u043E\u044F \u043F\u0435\u0440\u0432\u0430\u044F
    \u0441\u0435\u0441\u0441\u0438\u044F...</color>"
  - "<color=#00FFFF>\u0421 \u043C\u0435\u043D\u044F \u0445\u0432\u0430\u0442\u0438\u0442,
    \u044F \u0445\u043E\u0447\u0443 \u0432\u044B\u0439\u0442\u0438!! \u0412\u044B
    \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u0442\u0435\u0441\u0442 \u043D\u0435
    \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442 \u043C\u043D\u0435
    \"\u043E\u0441\u043E\u0431\u044B\u0445 \u043D\u0435\u0443\u0434\u043E\u0441\u0442\u0432\".</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440?: \u0432\u044B\u0445\u043E\u0434?
    \u0434\u0432\u0435\u0440\u0438 \u043D\u0435 \u0432\u0435\u0434\u0443\u0442..\u043D\u0430\u0440\u0443.\u0436\u0443,"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440?: 0\u043D\u0438 8\u043E\u0437\u0432\u0440\u0432\u0449\u0430\u044E\u0442
    \u0442\u0443\u0434\u0430/\u0433\u04343 \u0442\u044B..\u04340\u043B\u0436\u0435\u043D
    6\u044B\u0442\u044C..//"
  audioSource: {fileID: 1859292658}
  audioStartIndex: 6
