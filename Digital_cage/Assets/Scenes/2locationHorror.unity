--- !u!114 &2035804953
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2035804952}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5517fac785d090746bfbb407d1d3997f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueManager: {fileID: 583009123}
  dialogueLines:
  - "<color=#00FFFF>\u0427\u0442\u043E \u0437\u0430.. \u041F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435?
    \u042D\u0442\u043E \u0436\u0435 \u043C\u043E\u0439 \u0441\u0442\u0430\u0440\u044B\u0439
    \u0434\u043E\u043C...</color>"
  - "<color=#00FFFF>\u0422\u043E\u043B\u044C\u043A\u043E \u0432\u0441\u0451 \u043A\u0430\u043A\u043E\u0435-\u0442\u043E
    \u043E\u0431\u0432\u0435\u0442\u0448\u0430\u043B\u043E\u0435.. \u041D\u043E \u0434\u0430\u0436\u0435
    \u0437\u0430\u043F\u0430\u0445 \u0442\u043E\u0442 \u0436\u0435.</color>"
  - "<color=#00FFFF>\u041A\u0430\u043A \u044D\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435
    \u0432\u043E\u0441\u0441\u043E\u0437\u0434\u0430\u043B\u0438??</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0412\u0441\u0451 \u0432
    \u043F\u043E\u0440\u044F\u0434\u043A\u0435. \u042D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
    \u0440\u0435\u0430\u043A\u0446\u0438\u044F \u043C\u043E\u0437\u0433\u0430 - \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044F
    \u0430\u0434\u0430\u043F\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u0434
    \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0435 \u0444\u043E\u0440\u043C\u044B."
  - "<color=#00FFFF>\u041D\u0435\u0442.. \u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u201C\u0444\u043E\u0440\u043C\u044B\u201D. \u0422\u0443\u0442 \u0442\u0435 \u0436\u0435
    \u043F\u044F\u0442\u043D\u0430 \u043D\u0430 \u043E\u0431\u043E\u044F\u0445, \u0432\u044B
    \u043D\u0435 \u043C\u043E\u0433\u043B\u0438 \u044D\u0442\u043E\u0433\u043E \u0437\u043D\u0430\u0442\u044C.</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0421\u0438\u0441\u0442\u0435\u043C\u0430
    \u043E\u0431\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
    \u0447\u0435\u043C \u043C\u044B \u043E\u0436\u0438\u0434\u0430\u043B\u0438. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
    \u043E\u043D\u0430 \u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435,
    \u0447\u0435\u043C \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043B\u043E\u0441\u044C."
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041D\u043E \u043D\u0435
    \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0442\u0435\u0441\u044C. \u041D\u0430\u0448
    \u0442\u0435\u0441\u0442 \u043D\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442
    \u0432\u0430\u043C \u043E\u0441\u043E\u0431\u044B\u0445 \u043D\u0435\u0443\u0434\u043E\u0431\u0441\u0442\u0432!
    \u0412\u0441\u0451 \u043F\u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C."
  - "<color=#00FFFF>\u041F\u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C,
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E... \u0410 \u0447\u0435\u0433\u043E
    \u043C\u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u0436\u0434\u0430\u0442\u044C?</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u0441\u044C,
    \u043D\u0430\u0439\u0434\u0438\u0442\u0435 \u043F\u0430\u043C\u044F\u0442\u043D\u044B\u0435
    \u0432\u0435\u0449\u0438, \u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u044F
    \u043F\u0440\u043E\u0439\u0434\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
  - "<color=#00FFFF>\u041C\u0435\u043D\u044F \u043D\u0435 \u0431\u044B\u043B\u043E
    \u0437\u0434\u0435\u0441\u044C \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0430\u0432\u043D\u043E...</color>"
  blackScreenImage: {fileID: 1353929528}
  blackScreenDuration: 1
  fadeOutDuration: 2
