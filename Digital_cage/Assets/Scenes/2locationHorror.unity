  m_Script: {fileID: 11500000, guid: d405c770b042d9d4e9303e35e8408e2c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - "<color=#00FFFF>\u0427\u0442\u043E \u0437\u0430....</color>"
  - "<color=#00FFFF>\u042D\u0442\u0430 \u043D\u0430\u0434\u043F\u0438\u0441\u044C...
    \u043D\u0430 \u0441\u0442\u0435\u043A\u043B\u0435.</color>"
  - "<color=#00FFFF>\u0427\u0442\u043E \u0432\u0441\u0451 \u044D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442?</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041A\u0430\u043A\u0430\u044F
    \u043D\u0430\u0434\u043F\u0438\u0441\u044C? \u0413\u0434\u0435 \u0432\u044B \u044D\u0442\u043E
    \u0432\u0438\u0434\u0438\u0442\u0435?"
  - "<color=#00FFFF>\u0414\u0430 \u0432\u043E\u0442 \u0436\u0435 \u043F\u0440\u044F\u043C
    \u043F\u0435\u0440\u0435\u0434\u043E \u043C\u043D\u043E\u0439.</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0412\u0438\u043A\u0442\u043E\u0440,
    \u0432 \u043B\u043E\u043A\u0430\u0446\u0438\u0438 \u043D\u0435\u0442 \u043D\u0438\u043A\u0430\u043A\u0438\u0445
    \u0442\u0435\u043A\u0441\u0442\u043E\u0432\u044B\u0445 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432."
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0422\u0430\u043A\u043E\u0435
    \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430 \u044D\u0442\u0430\u043F\u0435 \u0434\u0435\u0437\u043E\u0440\u0438\u0435\u043D\u0442\u0430\u0446\u0438\u0438."
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0421\u0435\u0439\u0447\u0430\u0441
    \u0432\u0441\u0435 \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0438\u0440\u0443\u044E,
    \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043D\u0438\u0447\u0435\u0433\u043E
    \u043D\u0435 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0439\u0442\u0435."
