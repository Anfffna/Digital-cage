    \u043F\u0443\u0441\u0442\u0443\u044E \u0440\u0430\u043C\u043A\u0443?</color>"
  - "<color=#00FFFF>\u0427\u0442\u043E..\u0447\u0442\u043E \u044D\u0442\u043E. \u042D\u0442\u043E
    \u0436\u0435.. \u043C\u043E\u0434\u0435\u043B\u044C \u043C\u043E\u0435\u0439
    \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B?</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0412\u0438\u043A\u0442\u043E\u0440,
    \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043E\u0442\u043E\u0439\u0434\u0438\u0442\u0435
    \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u043E\u0431\u044A\u0435\u043A\u0442\u0430!
    \u042D\u0442\u043E \u043D\u0435 \u0432\u0430\u0448\u0435\u0433\u043E \u0443\u043C\u0430
    \u0434\u0435\u043B\u043E."
  - "<color=#00FFFF>\u0421\u0442\u043E\u043F... \u0430 \u0447\u0442\u043E \u044D\u0442\u043E
    \u0432 \u0443\u0433\u043B\u0443???</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0412\u0430\u043C \u043F\u043E\u043C\u0435\u0440\u0435\u0449\u0438\u043B\u043E\u0441\u044C.
    \u0422\u0430\u043A\u043E\u0435 \u0431\u044B\u0432\u0430\u0435\u0442, \u043A\u043E\u0433\u0434\u0430
    \u043F\u0441\u0438\u0445\u0438\u043A\u0430 \u0443\u0436\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u043D\u0430 \u0433\u0440\u0430\u043D\u0438."
  - "<color=#00FFFF>\u041D\u043E...</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0414\u041E\u0421\u0422\u0410\u0422\u041E\u0427\u041D\u041E.
    \u041E\u0431\u044A\u0435\u043A\u0442 \u043F\u043E\u043C\u0435\u0447\u0435\u043D
    \u043A\u0430\u043A \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044F, \u0434\u0430\u043D\u043D\u044B\u0435
    \u0443\u0434\u0430\u043B\u044F\u044E\u0442\u0441\u044F."
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: ..\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
    \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0434\u0438\u0442\u0435 \u0434\u0430\u043B\u044C\u0448\u0435.."
