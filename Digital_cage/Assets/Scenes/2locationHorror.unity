  dialogueManager: {fileID: 583009123}
  requiredDialogueIndex: 9
  doorDialogueTexts:
  - "<color=#00FFFF>\u0427\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u0441\u043E
    \u0441\u0442\u0435\u043D\u0430\u043C\u0438?..</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0439\u0442\u0435
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F, \u0432\u0438\u0437\u0443\u0430\u043B
    \u043C\u043E\u0436\u0435\u0442 \u0433\u043B\u044E\u0447\u0438\u0442\u044C."
  - "<color=#00FFFF>\u0418 \u044D\u0442\u0430 \u0441\u0442\u0440\u0435\u043C\u043D\u0430\u044F
    \u0434\u0432\u0435\u0440\u044C \u0441 \u0434\u043E\u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u0440\u0443\u0431\u0438\u043B\u044C\u043D\u0438\u043A\u043E\u043C... \u0415\u0451
    \u043D\u0435 \u0431\u044B\u043B\u043E.</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
    \u043E\u0442\u043B\u0430\u0434\u043E\u0447\u043D\u044B\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442. "
  - "<color=#00FFFF>\u0427\u0443\u0448\u044C. \u041E\u0442\u0442\u0443\u0434\u0430
    \u0432\u0435\u0435\u0442 \u0445\u043E\u043B\u043E\u0434\u043E\u043C \u0438 \u043F\u044B\u043B\u044C\u044E..
    \u041E\u043D\u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F.</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041F\u0440\u043E\u0441\u0442\u043E
    \u043D\u0435 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435
    \u0441 \u043D\u0435\u0439, \u0445\u043E\u0440\u043E\u0448\u043E? \u042D\u0442\u043E
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u0431\u043E\u0439."
  todoManager: {fileID: 140228595}
