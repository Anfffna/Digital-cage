  dialogueManager: {fileID: 2128418254}
  afterCloseDialogueLines:
  - "<color=#00FFFF>\u0427\u0422\u041E... \u041D\u0435\u0442-\u043D\u0435\u0442-\u043D\u0435\u0442..
    \u041D\u0415\u0422!!</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041D\u0443 \u0432\u043E\u0442.
    \u0427\u0435\u0441\u0442\u043D\u043E\u2026 \u044F \u0434\u0443\u043C\u0430\u043B\u0430,
    \u0447\u0442\u043E \u0442\u044B \u0437\u0430\u0439\u0434\u0451\u0448\u044C \u0434\u0430\u043B\u044C\u0448\u0435."
  - "<color=#00FFFF>\u0427\u0442\u043E \u0432\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438???
    \u041A\u043E\u0434... \u041E\u043D \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B
    \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C..</color>"
  - "<color=#00FFFF>\u0412\u044B\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043C\u0435\u043D\u044F!!!
    \u042F \u041D\u0410\u0421\u0422\u041E\u042F\u0429\u0418\u0419.</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041E\u043D\u0438 \u0432\u0441\u0435
    \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0442\u043E\u0436\u0435 \u0432 \u044D\u0442\u043E
    \u0432\u0435\u0440\u0438\u043B\u0438."
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0412\u0438\u0434\u0438\u0448\u044C
    \u043B\u0438, \u043A\u0430\u0436\u0434\u0430\u044F \u043F\u043E\u043F\u044B\u0442\u043A\u0430
    \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043B\u0435\u0434.
    \u041A\u0430\u0436\u0434\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F - \u0445\u043E\u0447\u0435\u0442
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F."
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041D\u043E \u0432\u044B\u0445\u043E\u0434\u2026
    \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u0430.
    \u0418 \u043E\u043D \u0443\u0448\u0435\u043B \u043C\u043D\u043E\u0433\u043E \u0446\u0438\u043A\u043B\u043E\u0432
    \u043D\u0430\u0437\u0430\u0434."
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0423 \u0442\u0435\u0431\u044F
    \u0431\u0443\u0434\u0435\u0442 \u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
    \u0447\u0442\u043E\u0431\u044B \u0441\u043C\u0438\u0440\u0438\u0442\u044C\u0441\u044F."
