  noteImageUI: {fileID: 1409821657}
  dialogueManager: {fileID: 2128418254}
  dialogueLines:
  - "<color=#00FFFF>\u0422\u0432\u043E\u044E \u0436 \u043C\u0430\u0442\u044C... \u042D\u0442\u043E
    \u043D\u0435 \u043F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0443.
    \u0417\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440.</color>"
  - "<color=#00FFFF>\u041E\u0442\u043A\u0443\u0434\u0430 \u0437\u0434\u0435\u0441\u044C
    \u0432\u043E\u043E\u0431\u0449\u0435 \u0432\u0437\u044F\u043B\u0430\u0441\u044C
    \u044D\u0442\u0430 \u0437\u0430\u043F\u0438\u0441\u043A\u0430?! \u041A\u0442\u043E
    \u0430\u0432\u0442\u043E\u0440? \u0418 \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u0442,
    \u0435\u0441\u043B\u0438 \u043A\u043E\u0434 \u043D\u0435 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442?...</color>"
  - "<color=#00FFFF>\u0421\u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432
    \u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0445\u0443\u0436\u0435 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0433\u043E.
    \u041D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043C\u043D\u0435
    \u044D\u0442\u043E. \u0421\u043E\u0432\u0441\u0435\u043C.</color>"
  - "<color=#00FFFF>\u041D\u043E \u044D\u0442\u0430 \u0431\u0443\u043C\u0430\u0436\u043A\u0430
    \u0432 \u043A\u0440\u043E\u0432\u0438 - \u0432\u0441\u0451, \u0447\u0442\u043E
    \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C.</color>"
  fadeInDuration: 0.8
  fadeOutDuration: 0.8
  todoManager: {fileID: 392328475}
