--- !u!114 &603734005
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 603734001}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9106d3f4719f7af498d2302661428f47, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  teleportPoint: {fileID: 1770841197}
  player: {fileID: 559924418}
  gameMachine: {fileID: 1312277582}
  note: {fileID: 1547976940}
  shadowBasement: {fileID: 632491164}
  teleportAudioClip: {fileID: 8300000, guid: 48a9abd12299a1342866b6924c4e2deb, type: 3}
  doorOpenSound: {fileID: 8300000, guid: 18cb1c7fc7657534cafc8995640b92ea, type: 3}
  audioSource: {fileID: 603734008}
  dialogueManager: {fileID: 2128418254}
  dialogueLines:
  - "<color=#00FFFF>\u0422\u0430\u043A, \u044F \u0441\u043D\u043E\u0432\u0430 \u0437\u0434\u0435\u0441\u044C.</color>"
  - "<color=#00FFFF>\u0418 \u0442\u0443\u0442... \u0435\u0449\u0451 \u0441\u0442\u0440\u0435\u043C\u043D\u0435\u0435
    \u0447\u0435\u043C \u0431\u044B\u043B\u043E.</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0412\u0438\u043A\u0442\u043E\u0440\u2026
    \u0447\u0442\u043E \u0432\u044B/-8\u0438\u043A\u0441\u0438\u0440\u0443\u2026\u0435\u0442\u04419.
    \u0430\u043D\u043E\u043C\u0430\u043B\u044C..\\\\\u0430\u043A\u0442\u0438.\u0432\u2026"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
    \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0435. \u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C
    \u043A \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u043C.
    \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435 \u0442\u0435\u0441\u0442."
  - "<color=#00FFFF>\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u043C? \u042F \u0442\u043E\u043B\u044C\u043A\u043E
    \u0447\u0442\u043E \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F \u0438\u0437
    \u043F\u043E\u0434\u0432\u0430\u043B\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C\u2026</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041F\u043E\u0434\u0432\u0430\u043B?
    \u042D\u0442\u043E\u0433\u043E... \u043D\u0435\u0442 \u0432 \u0432\u0435\u0440\u0441\u0438\u0438
    \u043B\u043E\u043A\u0430\u0446\u0438\u0438."
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041F\u0440\u043E\u0441\u0438\u043C
    \u043D\u0435 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C\u2026
    \u0441 \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435\u2026
    \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432---"
  - "<color=#00FFFF>\u0414\u0430\u0434\u0430. \u0421\u043F\u043E\u0440\u0438\u0442\u044C
    \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E...</color>"
  - "<color=#00FFFF>\u041D\u0430\u0434\u043E \u043D\u0430\u0439\u0442\u0438 \u043A\u0430\u043A
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u043E\u0442\u0441\u044E\u0434\u0430.
    \u041F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443.</color>"
  exitBlackScreen: {fileID: 1622303725}
  fadeDuration: 2
