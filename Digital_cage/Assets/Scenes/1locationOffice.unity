--- !u!114 &1900066007
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1900066006}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e6f3800d59d5f644c9dd44e4177e103e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueManager: {fileID: 583318721}
  dialogueLines:
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041C\u043E\u0436\u0435\u043C
    \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C. \u0421\u0438\u0441\u0442\u0435\u043C\u0430
    \u0431\u0443\u0434\u0435\u0442 \u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C \u043B\u0438\u043C\u0431\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0437\u043E\u043D\u044B \u0438 \u043F\u043E\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C
    \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u043F\u043E\u0434 \u0432\u0430\u0448\u0438
    \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0440\u0435\u0430\u043A\u0446\u0438\u0438. \u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0442\u0435\u0441\u044C
    - \u0432\u0441\u0451 \u043F\u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C."
  - "<color=#00FFFF>\u041B\u0438\u043C\u0431\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0437\u043E\u043D\u0430... \u042D\u0442\u043E \u0432\u0440\u043E\u0434\u0435
    \u043A\u0430\u043A \u0441\u0442\u0440\u0430\u0445?</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041C\u043E\u0436\u043D\u043E
    \u0438 \u0442\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C. \u0413\u043B\u0430\u0432\u043D\u043E\u0435
    - \u043D\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0439\u0442\u0435\u0441\u044C.
    \u0422\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u043F\u043E\u0439\u0434\u0451\u0442
    \u043C\u044F\u0433\u0447\u0435."
  - "<color=#00FFFF>\u201C\u041F\u0440\u043E\u0446\u0435\u0441\u0441\u201D? \u0417\u0432\u0443\u0447\u0438\u0442
    \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043E\u0431\u043D\u0430\u0434\u0451\u0436\u0438\u0432\u0430\u044E\u0449\u0435.</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041F\u0440\u043E\u0441\u0442\u043E
    \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u044C\u0442\u0435\u0441\u044C. \u041B\u044E\u0431\u043E\u0435
    \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
    \u0432\u044B\u0437\u043E\u0432\u0435\u0442 \u043D\u0435\u0439\u0440\u043E\u043D\u043D\u044B\u0439
    \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442. \u0410 \u044D\u0442\u043E\u0433\u043E
    \u043D\u0430\u043C \u043D\u0435 \u043D\u0443\u0436\u043D\u043E."
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0412\u044B \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B\u0438
    \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435. \u0410 \u0442\u0435\u043F\u0435\u0440\u044C
    \u0434\u043E\u0432\u0435\u0440\u044C\u0442\u0435\u0441\u044C \u0441\u0438\u0441\u0442\u0435\u043C\u0435."
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041E\u0442\u043B\u0438\u0447\u043D\u043E...
