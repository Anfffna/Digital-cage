--- !u!114 &1900066007
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1900066006}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e6f3800d59d5f644c9dd44e4177e103e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueManager: {fileID: 583318721}
  dialogueLines:
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041C\u043E\u0436\u0435\u043C
    \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430\u0442\u044C. \u042D\u0442\u043E
    \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E VR, \u043D\u0430\u0448\u0430
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
    \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435 \u043D\u0435\u0439\u0440\u043E\u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043A\u0438...
    \u0412 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0437\u043E\u043D\u044B
    \u0441\u0442\u0440\u0430\u0445\u0430. \u041D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439\u0442\u0435."
  - "<color=#00FFFF>\u041F\u043E\u0433\u043E\u0434\u0438\u0442\u0435... \u0417\u043E\u043D\u044B
    \u0441\u0442\u0440\u0430\u0445\u0430?</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041E\u043D\u0430 \u043F\u043E\u0434\u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F
    \u043F\u043E\u0434 \u0432\u0430\u0448\u0435 \u043F\u043E\u0434\u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435,
    \u043F\u043E\u043A\u0430\u0436\u0435\u0442 \u0438\u043C\u0435\u043D\u043D\u043E
    \u0432\u0430\u0448\u0438 \u043A\u043E\u0448\u043C\u0430\u0440\u044B. \u0422\u0430\u043A
    \u043C\u044B \u0442\u0435\u0441\u0442\u0438\u0440\u0443\u0435\u043C \u043F\u0440\u0435\u0434\u0435\u043B\u044B
    \u0440\u0435\u0430\u043B\u0438\u0437\u043C\u0430."
  - "<color=#00FFFF>\u041D\u043E \u044F \u043D\u0435 \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u0441\u044F
    \u043D\u0430 \u044D\u0442\u043E!!!</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041D\u0443\u0436\u043D\u043E
    \u0431\u044B\u043B\u043E \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
