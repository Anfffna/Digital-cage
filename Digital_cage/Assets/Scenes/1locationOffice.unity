  m_Script: {fileID: 11500000, guid: 33c57ee4a89033944b78fa723bd8150b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueManager: {fileID: 583318721}
  dialogueLines:
  - "<color=#00FFFF>\u0427\u0435\u0440\u0442, \u0447\u0435\u0440\u0442, \u0447\u0435\u0440\u0442...
    \u0421\u0442\u0440\u0435\u043C\u043D\u043E\u0432\u0430\u0442\u043E \u0437\u0434\u0435\u0441\u044C,
    \u043D\u043E \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0443\u0436\u043D\u044B
    \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u043E\u0437\u0430\u0440\u0435\u0437.</color>"
  - "<color=#00FFFF>\u0421\u043E\u0431\u0435\u0440\u0443 \u0445\u043E\u0442\u044C
    \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442, \u0437\u0430 \u0442\u0430\u043A\u043E\u0435
    \u043C\u043D\u0435 \u043D\u0435\u043F\u043B\u043E\u0445\u0443\u044E \u0432\u044B\u043F\u043B\u0430\u0442\u0443
    \u0434\u0430\u0434\u0443\u0442. \u0413\u0434\u0435-\u0442\u043E \u0434\u043E\u043B\u0436\u0435\u043D
    \u0431\u044B\u0442\u044C \u0447\u0438\u043F</color>"
  - "<color=#00FFFF>\u0410 \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u044D\u0442\u0430
    \"\u0431\u0430\u0437\u043E\u0432\u0430\u044F \u0434\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430\"
    \u0431\u044B\u043B\u0430 \u043D\u0435 \u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u043A\u043E\u0439,
    \u0430 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u043E\u0439?</color>"
  - "<color=#00FFFF>\u0427\u0442\u043E \u0435\u0441\u043B\u0438 \u043E\u043D\u0438
    \u043D\u0435 \u0438\u0437\u0443\u0447\u0430\u044E\u0442 \u043C\u043E\u0435 \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0435...
    \u0430 \u0434\u043E\u043F\u043E\u043B\u043D\u044F\u044E\u0442 \u0435\u0433\u043E??</color>"
  - "<color=#00FFFF>\u041D\u0430\u0432\u0435\u0440\u043D\u043E \u044F \u043F\u0435\u0440\u0435\u0441\u043C\u043E\u0442\u0440\u0435\u043B
    \u0443\u0436\u0430\u0441\u0442\u0438\u043A\u043E\u0432</color>"
  - "<color=#00FFFF>\u0421\u043B\u044B\u0448\u0443 \u0448\u0430\u0433\u0438... \u041D\u0430\u0434\u043E
    \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0441\u0435\u0441\u0442\u044C \u0438
    \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u0442\u0435\u043B\u0435\u0444\u043E\u043D,
    \u043A\u0430\u043A \u043B\u0435\u0436\u0430\u043B</color>"
  handPhoneController: {fileID: 1436434747}
  toDoUI: {fileID: 1120492988}
