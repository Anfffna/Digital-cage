  - "\u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0446\u0430: ..."
  - "\u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0446\u0430: \"21 \u043D\u043E\u044F\u0431\u0440\u044F,
    \u0432\u0440\u0435\u043C\u044F 20:49.\""
  - "\u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0446\u0430: \"\u0412\u0445\u043E\u0434\u044F\u0449\u0438\u0439
    \u0441\u0438\u0433\u043D\u0430\u043B \u043F\u043E\u043C\u0435\u0448\u0430\u043B
    \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0435. \u0421\u0438\u043D\u043E\u043F\u0441\u044B
    \u043C\u043E\u0437\u0433\u0430 \u0441\u0443\u0431\u044A\u0435\u043A\u0442\u0430
