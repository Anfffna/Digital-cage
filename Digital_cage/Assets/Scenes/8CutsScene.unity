  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041E\u0439, \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!
    \u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435 \u0437\u0430 \u043F\u043E\u0442\u0451\u043C\u043A\u0438...
    \u041F\u0440\u043E\u0438\u0437\u043E\u0448\u0435\u043B \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439
    \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442: \u0432\u0441\u0435 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u044B
    \u0438 \u043F\u0440\u0438\u0431\u043E\u0440\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442,
    \u0430 \u0432\u043E\u0442 \u043E\u0431\u0449\u0438\u0439 \u0441\u0432\u0435\u0442
    \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u043D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F."
  - "<color=#00FFFF>\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435 \u043D\u0443\u0436\u043D\u043E
    \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u0439\u0442\u0438 \u0437\u0430\u0432\u0442\u0440\u0430,
    \u0430 \u043D\u0435 \u0442\u0430\u0449\u0438\u0442\u044C\u0441\u044F \u0432 \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445...</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0427\u0435\u0441\u0442\u043D\u043E
    \u0433\u043E\u0432\u043E\u0440\u044F \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u043B\u0430,
    \u0447\u0442\u043E \u0432\u044B \u0442\u0430\u043A \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u043E
    \u044F\u0432\u0438\u0442\u0435\u0441\u044C. \u041D\u043E \u0435\u0441\u043B\u0438
    \u0432\u044B \u043D\u0435 \u0431\u043E\u0438\u0442\u0435\u0441\u044C \u0442\u0435\u043C\u043D\u043E\u0442\u044B,
    \u0442\u043E \u043C\u044B \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u043C\u0441\u044F.
    \u041F\u0440\u0438\u0441\u0430\u0436\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044C,
    \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
  - "<color=#00FFFF>\u041C\u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u044B\u043B\u0438
    \u043D\u0443\u0436\u043D\u044B \u0434\u0435\u043D\u044C\u0433\u0438.. \u041A\u0430\u043A
    \u0438 \u0432\u0441\u0435\u043C, \u043A\u0442\u043E \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E
    \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F \u043D\u0430
    \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u044B
    \u0432 \u0442\u0435\u043C\u043D\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430
    \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0432\u0430\u0448 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u044B\u0439
    \u0438 \u0441\u0434\u0430\u0439\u0442\u0435 \u043D\u0430 \u0432\u0440\u0435\u043C\u044F
    \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u044B, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430"
  - "<color=#00FFFF>\u0421\u043C\u0430\u0445\u0438\u0432\u0430\u0435\u0442 \u043D\u0430
    \u043F\u0430\u0440\u0430\u043D\u043E\u0439\u044E, \u0432\u0430\u043C \u043D\u0435
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F?</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
    \u043F\u0440\u0435\u0432\u044B\u0448\u0435 \u0432\u0441\u0435\u0433\u043E!"
  - "<color=#00FFFF>\u041D\u0443..\u043B\u0430\u0434\u043D\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
    \u0435\u0441\u043B\u0438 \u043C\u043D\u0435 \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u0442
    \u0431\u043E\u043D\u0443\u0441 \u0437\u0430 \"\u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0430\u043D\u0438\u0435
    \u0441 \u043B\u0438\u0447\u043D\u044B\u043C \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u043C\"</color>"
  - "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440: \u041E\u0442\u043B\u0438\u0447\u043D\u043E.
    \u0414\u043B\u044F \u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u043A\u0438
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
    \u0431\u0430\u0437\u043E\u0432\u0430\u044F \u0434\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430.
    \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0437\u0430\u0439\u043C\u0438\u0442\u0435
    \u043F\u043E\u0437\u0438\u0446\u0438\u044E \u0443 \u0441\u0435\u043D\u0441\u043E\u0440\u043D\u043E\u0439
    \u043F\u0430\u043D\u0435\u043B\u0438 \u0441\u043B\u0435\u0432\u0430 \u043E\u0442
    \u0432\u0430\u0441."
  continueFromLine: 9
  handPhoneController: {fileID: 0}
  dialogueTrigger2: {fileID: 0}
  audioSource: {fileID: 1889313174}
  triggerSound: {fileID: 8300000, guid: 3db460407d0e1ae42b67465eeae5998a, type: 3}
